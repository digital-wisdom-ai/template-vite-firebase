{
  "color": {
    "primary": {
      "50": "#e3f2fd",
      "100": "#bbdefb",
      "200": "#90caf9",
      "300": "#64b5f6",
      "400": "#42a5f5",
      "500": "#2196f3",
      "600": "#1e88e5",
      "700": "#1976d2",
      "800": "#1565c0",
      "900": "#0d47a1"
    },
    "secondary": {
      "50": "#fce4ec",
      "100": "#f8bbd9",
      "200": "#f48fb1",
      "300": "#f06292",
      "400": "#ec407a",
      "500": "#e91e63",
      "600": "#d81b60",
      "700": "#c2185b",
      "800": "#ad1457",
      "900": "#880e4f"
    },
    "neutral": {
      "50": "#fafafa",
      "100": "#f5f5f5",
      "200": "#eeeeee",
      "300": "#e0e0e0",
      "400": "#bdbdbd",
      "500": "#9e9e9e",
      "600": "#757575",
      "700": "#616161",
      "800": "#424242",
      "900": "#212121"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px",
    "container": {
      "mobile": "16px",
      "tablet": "24px",
      "desktop": "32px"
    },
    "button": {
      "default": {
        "mobile": "12px 16px",
        "tablet": "14px 20px",
        "desktop": "16px 24px"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "mono": "JetBrains Mono, \"Fira Code\", Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "xxl": "24px",
      "h1": "32px",
      "h2": "28px",
      "h3": "24px",
      "h4": "20px",
      "h5": "18px",
      "h6": "16px"
    },
    "fontWeight": {
      "light": "300",
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    }
  },
  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "layout": {
    "container": {
      "centerPage": {
        "display": "flex",
        "flexDirection": "column",
        "alignItems": "center",
        "justifyContent": "center",
        "minHeight": "100vh"
      },
      "page": {
        "maxWidth": "1200px",
        "margin": "0 auto",
        "padding": "2rem"
      }
    },
    "button": {
      "base": {
        "display": "inline-flex",
        "alignItems": "center",
        "border": "none",
        "cursor": "pointer"
      },
      "primary": {
        "small": {
          "padding": "10px 16px",
          "fontSize": "12px",
          "backgroundColor": "#1ea7fd",
          "color": "#ffffff"
        },
        "medium": {
          "padding": "11px 20px",
          "fontSize": "14px",
          "backgroundColor": "#1ea7fd",
          "color": "#ffffff"
        },
        "large": {
          "padding": "12px 24px",
          "fontSize": "16px",
          "backgroundColor": "#1ea7fd",
          "color": "#ffffff"
        }
      },
      "secondary": {
        "small": {
          "padding": "10px 16px",
          "fontSize": "12px",
          "backgroundColor": "transparent",
          "color": "#1ea7fd",
          "border": "1px solid #1ea7fd"
        },
        "medium": {
          "padding": "11px 20px",
          "fontSize": "14px",
          "backgroundColor": "transparent",
          "color": "#1ea7fd",
          "border": "1px solid #1ea7fd"
        },
        "large": {
          "padding": "12px 24px",
          "fontSize": "16px",
          "backgroundColor": "transparent",
          "color": "#1ea7fd",
          "border": "1px solid #1ea7fd"
        }
      }
    },
    "header": {
      "container": {
        "display": "flex",
        "justifyContent": "space-between",
        "alignItems": "center",
        "padding": "15px 20px",
        "backgroundColor": "#ffffff",
        "boxShadow": "rgba(0, 0, 0, 0.1) 0px 1px 3px 0px"
      },
      "brand": {
        "display": "flex",
        "alignItems": "center",
        "gap": "10px"
      },
      "nav": {
        "display": "flex",
        "alignItems": "center",
        "gap": "20px"
      }
    }
  },
  "states": {
    "button": {
      "primary": {
        "default": {
          "backgroundColor": "#1ea7fd",
          "color": "#ffffff"
        },
        "hover": {
          "backgroundColor": "#1593e0"
        }
      },
      "secondary": {
        "default": {
          "backgroundColor": "transparent",
          "color": "#333333"
        },
        "hover": {
          "backgroundColor": "rgba(255,255,255,0.9)"
        }
      },
      "disabled": {
        "backgroundColor": "#bdbdbd",
        "cursor": "not-allowed"
      }
    }
  },
  "googleButton": {
    "base": {
      "userSelect": "none",
      "WebkitUserSelect": "none",
      "MozUserSelect": "none",
      "msUserSelect": "none",
      "WebkitAppearance": "none",
      "backgroundColor": "WHITE",
      "backgroundImage": "none",
      "border": "1px solid #747775",
      "WebkitBorderRadius": "20px",
      "borderRadius": "20px",
      "WebkitBoxSizing": "border-box",
      "boxSizing": "border-box",
      "color": "#1f1f1f",
      "cursor": "pointer",
      "fontFamily": "'Roboto', arial, sans-serif",
      "fontSize": "14px",
      "height": "40px",
      "letterSpacing": "0.25px",
      "outline": "none",
      "overflow": "hidden",
      "padding": "0 12px",
      "position": "relative",
      "textAlign": "center",
      "WebkitTransition": "background-color .218s, border-color .218s, box-shadow .218s",
      "transition": "background-color .218s, border-color .218s, box-shadow .218s",
      "verticalAlign": "middle",
      "whiteSpace": "nowrap",
      "width": "auto",
      "maxWidth": "400px",
      "minWidth": "min-content",
      "&:hover": {
        "WebkitBoxShadow": "0 1px 2px 0 rgba(60, 64, 67, .30), 0 1px 3px 1px rgba(60, 64, 67, .15)",
        "boxShadow": "0 1px 2px 0 rgba(60, 64, 67, .30), 0 1px 3px 1px rgba(60, 64, 67, .15)"
      },
      "&:disabled": {
        "cursor": "default",
        "backgroundColor": "#ffffff61",
        "borderColor": "#1f1f1f1f"
      }
    },
    "icon": {
      "height": "20px",
      "marginRight": "12px",
      "minWidth": "20px",
      "width": "20px"
    },
    "contentWrapper": {
      "WebkitAlignItems": "center",
      "alignItems": "center",
      "display": "flex",
      "WebkitFlexDirection": "row",
      "flexDirection": "row",
      "WebkitFlexWrap": "nowrap",
      "flexWrap": "nowrap",
      "height": "100%",
      "justifyContent": "space-between",
      "position": "relative",
      "width": "100%"
    },
    "contents": {
      "WebkitFlexGrow": "1",
      "flexGrow": "1",
      "fontFamily": "'Roboto', arial, sans-serif",
      "fontWeight": "500",
      "overflow": "hidden",
      "textOverflow": "ellipsis",
      "verticalAlign": "top"
    }
  },
  "breakpoints": {
    "mobile": "0px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1200px"
  }
}
